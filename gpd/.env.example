APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=text

AWS_REGION=us-east-1
AWS_S3_BUCKET=your-firehose-bucket
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/your-queue
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20

REDSHIFT_HOST=your-redshift-cluster.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password
REDSHIFT_SSLMODE=require
REDSHIFT_QUERY_CHUNK_SIZE=500

FTP_PROTOCOL=sftp
FTP_HOST=ftp.example.com
FTP_PORT=22
FTP_USER=your_user
FTP_PASSWORD=your_password
FTP_REMOTE_PATH=/incoming/email-verification
FTP_TIMEOUT_SECONDS=30

BATCH_SIZE=100
REQUEST_FILE_PREFIX=batch
REQUEST_OUTPUT_DIR=out/verification_requests
